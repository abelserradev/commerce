generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  draft_cart
  pending_confirmation
  confirmed
  cancelled
}

enum ChannelType {
  telegram
  whatsapp
}

model MerchantUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant Merchant?
}

model Merchant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        MerchantUser          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products     Product[]
  orders       Order[]
  channelLinks ChannelLink[]
  sessions     ConversationSession[]
}

model Product {
  id          String   @id @default(uuid())
  merchantId  String
  name        String
  description String   @default("")
  priceAmount Decimal  @db.Decimal(14, 2)
  currency    String   @default("USD")
  stockQty    Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]

  @@index([merchantId, isPublished])
}

model Order {
  id             String      @id @default(uuid())
  merchantId     String
  status         OrderStatus @default(draft_cart)
  customerLabel  String      @default("")
  customerPhone  String?
  channel        ChannelType
  externalChatId String
  idempotencyKey String?     @unique
  confirmedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  merchant Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  lines    OrderLine[]

  @@index([merchantId, status, createdAt])
}

model OrderLine {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(14, 2)
  lineTotal Decimal @db.Decimal(14, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model ChannelLink {
  id               String      @id @default(uuid())
  merchantId       String
  channel          ChannelType
  externalId       String
  displayName      String      @default("")
  webhookSecretRef String?
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([merchantId])
}

model ConversationSession {
  id             String      @id @default(uuid())
  merchantId     String
  channel        ChannelType
  externalChatId String
  cartJson       Json        @default("{}")
  pendingAction  String?
  expiresAt      DateTime
  updatedAt      DateTime    @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, channel, externalChatId])
}

model WebhookDedupe {
  id        String   @id @default(uuid())
  source    String
  messageId String
  createdAt DateTime @default(now())

  @@unique([source, messageId])
}
